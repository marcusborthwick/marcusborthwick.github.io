---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "My Website",
  description = "My personal website.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="stylesheet" href="/css/main.css" />
</head>

  <body>
    <header>
      <nav>
          <a href="/" class:list={{ active: Astro.url.pathname === "/" }}>
              Home
          </a>

          <a
              href="/blog/"
              class:list={{ active: Astro.url.pathname.startsWith("/blog") }}
          >
              Blog
          </a>

          <a
              href="/about/"
              class:list={{ active: Astro.url.pathname.startsWith("/about") }}
          >
              About
          </a>

          <a
              href="/photography/"
              class:list={{
                  active: Astro.url.pathname.startsWith("/photography"),
              }}
          >
              Photography
          </a>

          <a
              href="/music/"
              class:list={{ active: Astro.url.pathname.startsWith("/music") }}
          >
              Music
          </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

     <footer>
      <p>© 2026 My Website</p>
    </footer>

    <script src="/js/main.js" is:inline></script>
  </body>
</html>