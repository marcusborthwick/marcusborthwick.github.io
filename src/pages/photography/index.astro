---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Photography">
    <section class="photography-gallery">
        <figure>
            <img
                src="/images/photography/hill-moon.png"
                alt="A hillside beneath a blue sky with the moon visible above"
            />
        </figure>

        <figure>
            <img
                src="/images/photography/Branch.jpg"
                alt="A photograph of a branch"
            />
        </figure>
    </section>
</BaseLayout>